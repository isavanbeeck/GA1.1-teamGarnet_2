   "source": [
    "def distance_from_zero(x):\n",
    "    return abs(subtract(x,0))\n",
    "\n",
    "print(distance_from_zero(-5))  # Output: 5\n",
    "print(distance_from_zero(10))  # Output: 10"
   ]
